const { MongoClient } = require("mongodb");

const uri = process.env.MONGODB_URI || "mongodb://localhost:27017";
const dbName = process.env.MONGODB_DB || "nextjs_api_steps_practice";
const client = new MongoClient(uri);

const movies = [
  { code: "M001", title: "파묘", year: 2024, genre: "mystery" },
  { code: "M002", title: "범죄도시4", year: 2024, genre: "action" },
  { code: "M003", title: "서울의 봄", year: 2023, genre: "drama" },
  { code: "M004", title: "콘크리트 유토피아", year: 2023, genre: "drama" },
];

async function seed() {
  try {
    if (!dbName.startsWith("nextjs_api_steps_")) {
      throw new Error("MONGODB_DB는 nextjs_api_steps_로 시작해야 합니다.");
    }
    await client.connect();
    const db = client.db(dbName);
    await db.dropDatabase();
    await db.collection("movies").insertMany(movies);
    console.log(`${dbName} DB를 초기화하고 movies에 ${movies.length}개를 저장했습니다.`);
  } finally {
    await client.close();
  }
}

seed().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});